{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/audit.js": {
      "maxDuration": 300,
      "includeFiles": "node_modules/@sparticuz/chromium/bin/**"
    },
    "api/steps.js": {
      "maxDuration": 60
    },
    "api/reports.js": {
      "maxDuration": 60
    }
  }
}
