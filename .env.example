# Single-project Vercel deployment: create a Vercel Blob store and connect it
# to this project. Vercel writes BLOB_READ_WRITE_TOKEN automatically.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxx

# Optional: enables AI step generation and semantic review.
GEMINI_API_KEY=your_gemini_api_key

# Only needed when hosting the front end separately from its API.
VITE_API_BASE_URL=
ALLOWED_ORIGINS=https://a11y.woooooo.cn
