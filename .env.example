# Single-project Vercel deployment: create a Public Vercel Blob store and
# connect it to this project. Vercel injects BLOB_STORE_ID and OIDC credentials.
BLOB_STORE_ID=store_xxx

# Optional: enables AI step generation and semantic review.
GEMINI_API_KEY=your_gemini_api_key

# Only needed when hosting the front end separately from its API.
VITE_API_BASE_URL=
ALLOWED_ORIGINS=https://a11y.woooooo.cn
